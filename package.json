{
  "name": "bits-erfolgsgeschichte-assistent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interview-Assistent fuer BITS-Erfolgsgeschichten: Fakten sammeln, Fassungen je Ziel erzeugen",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/api/server.ts",
    "server": "node --disable-warning=ExperimentalWarning --watch server/src/api/server.ts",
    "web": "npm --prefix web run dev",
    "dev": "node scripts/dev.mjs",
    "seed": "node --disable-warning=ExperimentalWarning server/src/seed/seed.ts",
    "seed:ersetzen": "node --disable-warning=ExperimentalWarning server/src/seed/seed.ts --ersetzen",
    "build": "npm --prefix web run build",
    "typen": "node web/node_modules/typescript/bin/tsc --noEmit -p server/tsconfig.json",
    "test": "npm run typen && node --disable-warning=ExperimentalWarning --test server/test/*.test.ts",
    "setup": "npm install && npm --prefix web install && npm run seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "zod": "^4.4.3"
  }
}
