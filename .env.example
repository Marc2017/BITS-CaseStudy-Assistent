# Zugang zur KI-API.
#
# OHNE Zugang laeuft der Assistent vollstaendig - nur die KI-Funktionen
# (Interview, Formulieren, Import, Lernmodus) sind dann aus. Fakten von Hand
# eintragen und Fassungen selbst schreiben geht weiter.
#
# Diese Datei ist die Alternative zur Eingabe in der Oberflaeche
# (Verwaltung -> Einstellungen). Was in der Oberflaeche steht, hat Vorrang und
# wirkt sofort; Aenderungen hier brauchen einen Neustart.

# ---------------------------------------------------------------- Anthropic
# Schluessel anlegen: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------- Azure OpenAI (vorbereitet)
# Fuer den datenschutzkonformen Betrieb. Alle drei Angaben werden gebraucht.
# Ungetestet, solange es keinen Endpunkt gibt (docs/03-annahmen.md, O-04).
AZURE_OPENAI_ENDPUNKT=https://<name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_VERSION=2026-02-01

# Port des Backends
PORT=4700
